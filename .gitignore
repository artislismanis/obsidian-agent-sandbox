# Build output
plugin/dist/

# npm
node_modules/

# IDE
.idea
.vscode

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# env (`.env` matches at any depth, covers container/.env too)
.env

# Coverage
coverage/

# Editor swap / backup files
*.swp
*.swo
*~

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local cache directories
.cache/

# wdio-obsidian-service downloaded Obsidian binaries and test run logs
plugin/.obsidian-cache/
plugin/wdio-logs/

# Docker auto-creates workspace/vault/ as a root-owned empty mount
# point when `container/docker-compose.yml` bind-mounts the real vault
# on top of /workspace/vault. It's shadowed by the mount while the
# container runs and is just inert clutter when stopped.
workspace/vault/

# Claude Code sandbox masking layer bind-mounts /dev/null over these
# host-config paths inside the sandbox. They appear as untracked
# character devices in `git status` but can never be committed.
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.gitmodules
.ripgreprc

# ── Claude Code ──────────────────────────────────────────
# Policy: project .claude/ config is shared by default (deny-list).
# Only runtime state and personal/local files are ignored below.
# See: https://code.claude.com/docs/en/claude-directory

# Sub-package .claude/ dirs aren't real config — only monorepo-root and workspace/ are
plugin/.claude/
container/.claude/

# Runtime state (any .claude/ at any depth)
**/.claude/worktrees/
**/.claude/.cc-writes/
**/.claude/routines/
**/.claude/launch.json
**/.claude/scheduled_tasks.*

# Local-only subagent memory (memory: local)
**/.claude/agent-memory-local/

# Personal/local overrides (Anthropic's .local. convention)
**/.claude/*.local.json
**/.claude/*.local.md
CLAUDE.local.md
tmux-*.log

# test artifacts
plugin/test/fixtures/vault/.oas/memory.json
container/example-vault/.oas/memory.json
